# shellcheck shell=bash

rm -f "${CONFIG_DIR}/wireguard/forwarded_port_validated"

if pid=$(pidof "qbittorrent-nox-lib${LIBTORRENT//v/}"); then
    log_inf "[QBITTORRENT] Shutting down to restart with forwarded port [${port}]."
    kill "${pid}"
fi

echo "${port}" > "${CONFIG_DIR}/wireguard/forwarded_port_validated"
